@@ -1,8 +1,10 @@
+import type { FastifyReply } from 'fastify';
 import type { Container } from '../../platform/container.js';
 import { AppError, NotFoundError } from '../../platform/errors.js';
 import type { AgentRow } from '../../db/rows.js';
 import { ReviewRepository } from './repository.js';
+import { OctokitGitHubClient } from '../../adapters/github/octokit.js';
 import { reviewToDto } from './helpers.js';
 
 export class ReviewService {
   constructor(private readonly container: Container) {}
@@ -40,6 +42,18 @@ export class ReviewService {
     return reviewToDto(row);
   }
 
+  /** Publishes the finished review back to the pull request. */
+  async publish(workspaceId: string, reviewId: string, reply: FastifyReply): Promise<void> {
+    const github = new OctokitGitHubClient(process.env.GITHUB_TOKEN ?? '');
+    const row = await this.container.reviewRepository.byId(workspaceId, reviewId);
+    if (!row) throw new NotFoundError('review');
+    await github.createReview({
+      owner: row.owner,
+      repo: row.repo,
+      body: reviewToDto(row).summary_md,
+    });
+    reply.code(202).send({ published: true });
+  }
 }
