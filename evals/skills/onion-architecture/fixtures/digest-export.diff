 import type { ReviewDto } from '../../vendor/shared/contracts/reviews.js';
 
-export function toReviewDto(row: { id: string; summary_md: string }): ReviewDto {
+export function toReviewDto(row: ReviewRow): ReviewDto {
   return { id: row.id, summary_md: row.summaryMd };
 }
+
+/** Pure formatter: DTO -> the markdown body the export endpoint returns. */
+export function toMarkdownDigest(dto: ReviewDto): string {
+  return `# Review ${dto.id}\n\n${dto.summary_md}\n`;
+}
