# @devdigest/mcp — the two variables this server reads.
#
# NOTHING LOADS THIS FILE. There is no dotenv dependency in this package: the MCP
# server is spawned by its client (Claude Code, or the Inspector), and the client
# is what passes the environment — the `env` block of the repo's `.mcp.json`, or
# an inline assignment on the command line. This file exists to document the two
# names and their defaults in one place.

# Where the DevDigest API is listening. It must already be running — start the
# whole stack with ./scripts/dev.sh from the repository root. Must be an absolute
# http or https URL; a trailing slash is stripped.
DEVDIGEST_API_URL=http://localhost:3001

# How long run_agent_on_pr waits for a review to finish, in milliseconds, before
# it reports the run as still running rather than inventing a verdict. Must be a
# positive whole number. Set it to 1 to exercise the timeout branch without
# spending a model call.
#
# The client has a bound of its own: the `timeout` field of the repo's
# `.mcp.json` (180000). It must stay strictly above this value, or the client
# gives up before the tool can answer "still running" with the run id. Raising
# this one means raising that one too.
DEVDIGEST_MCP_RUN_TIMEOUT_MS=120000
